POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

TELEGRAM_BOT_TOKEN=
# Backward-compatible alias also supported: TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: restrict interactive commands to this chat ID.
TELEGRAM_COMMAND_CHAT_ID=

# Optional: dispatch on-demand Telegram commands to GitHub Actions.
GITHUB_REPOSITORY=owner/repository
GITHUB_ACTIONS_TOKEN=
GITHUB_REF=main

# AI market summary. Keep this only in .env, never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# IPO GMP: optional third-party source (informal, not exchange data).
IPO_GMP_API_URL=
# If using IPO Guru, leave IPO_GMP_API_URL empty and set the API key below.
IPO_GMP_API_KEY=

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=

# Scheduler
COLLECT_INTERVAL=300
RUN_ON_STARTUP=true
